{
  "name": "uefipatcher-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/lib/proto --ts_proto_opt=forceLong=string --proto_path=../crates/uefi-proto/proto engine.proto",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.15.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "ts-proto": "^2.12.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
